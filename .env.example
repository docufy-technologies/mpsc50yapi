# ---------------------------------------------------------------------------
# Required. The application fails to import if any of these are missing.
# ---------------------------------------------------------------------------

# SQLite for development, PostgreSQL in production.
DATABASE_URI="sqlite:///./mpsc50years.db"

# Signing key for the access token. Use a private key when JWT_ALGORITHM=RS256,
# and the matching public key in JWT_PUBLIC_KEY. Minimum 32 bytes for HS256.
JWT_SECRET_KEY=""
JWT_PUBLIC_KEY=""
JWT_ALGORITHM=""

# Name of the httpOnly cookie holding the access token.
ACCESS_TOKEN_NAME="alumna_access_token"

# Shared secret for the X-Admin-Secret header on /admin/*.
ADMIN_SECRET=""

# ---------------------------------------------------------------------------
# Optional. Every value below is the built-in default.
# ---------------------------------------------------------------------------

# Name of the httpOnly cookie the admin panel's session is stored in. Kept
# distinct from ACCESS_TOKEN_NAME so the two sessions can never be confused.
ADMIN_TOKEN_NAME="mpsc_admin_token"

# Must be set to 1 for local development. Without it the access cookie is
# issued with Secure and SameSite=None, which browsers drop over plain
# http://localhost, so login appears to fail with no visible reason.
DEV_MODE=1

# Public origin of THIS api. SSLCommerz redirects the browser to
# {API_URL}/payments/callback so the transaction is validated server-to-server
# before the alumna sees a success page. Must be the API, not the frontend.
API_URL="http://localhost:8000"

# Where the alumna's browser is sent for success/cancel pages.
FRONTEND_URL="http://localhost:3000"

# Participation fee in BDT. Charged by /payments/initiate and advertised by
# /public/event. Keep these in sync by using this one variable.
EVENT_FEE_BDT=1500

# Cookie domain in production, e.g. ".docufybd.com" for a shared subdomain.
# Leave empty in development so the cookie is host-only.
COOKIE_DOMAIN=""

# SSLCommerz store credentials. Required: /payments/initiate returns 503
# "Payment gateway is not configured" while either value is empty.
# Get sandbox credentials from https://sandbox.sslcommerz.com/developer/api
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX=1
